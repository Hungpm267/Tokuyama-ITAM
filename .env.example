# Sao thành .env cho môi trường DEV. KHÔNG commit file .env.
# Chuỗi kết nối PRODUCTION không bao giờ được đặt vào môi trường mà agent code chạy được.
ITAM_ENV=dev
ITAM_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/itam_dev
ITAM_TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/itam_test

# Sinh bằng: python -m scripts.genkey
# Trên máy IT, giá trị thật lấy từ Windows Credential Manager, KHÔNG để trong file này.
ITAM_SECRET_KEY_V1=
